{
  "name": "@istock-shell/ui",
  "version": "0.1.4",
  "description": "专为交互式命令终端与对话式AI场景设计的现代化UI组件库",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./style": "./src/index.css",
    "./example": "./src/components/example.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "*.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:common": "vite build --config vite.config.common.ts",
    "build:all": "npm run build && npm run build:common",
    "build:vite": "vite build",
    "build:watch": "vite build --watch",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint src --ext .js,.ts,.svelte",
    "lint:fix": "eslint src --ext .js,.ts,.svelte --fix",
    "format": "prettier --write src/**/*.{js,ts,svelte,css,md}",
    "size-check": "echo \"Bundle size check skipped\"",
    "prepublishOnly": "npm run build && npm run check && npm run lint",
    "publish:npm": "npm publish --access public",
    "publish:dry-run": "npm pack --dry-run",
    "release": "npm run build && npm run check && npm run lint && npm publish --access public"
  },
  "keywords": [
    "svelte",
    "ui",
    "components",
    "terminal",
    "ai",
    "shell",
    "typescript",
    "tailwindcss",
    "daisyui"
  ],
  "author": "xcbclc",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xcbclc/istock-shell.git"
  },
  "bugs": {
    "url": "https://github.com/xcbclc/istock-shell/issues"
  },
  "homepage": "https://github.com/xcbclc/istock-shell#readme",
  "engines": {
    "node": ">=16",
    "npm": ">=7"
  },
  "peerDependencies": {
    "svelte": "^5.32.1"
  },
  "dependencies": {
    "@antv/g2": "^5.3.3",
    "highlight.js": "^11.11.1",
    "marked": "^15.0.12",
    "marked-highlight": "^2.2.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/vite": "4.1.7",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^22.0.0",
    "daisyui": "5.0.35",
    "eslint": "^9.27.0",
    "eslint-plugin-svelte": "^3.9.0",
    "glob": "^10.3.10",
    "prettier": "^3.0.0",
    "prettier-plugin-svelte": "^3.0.0",
    "svelte": "^5.32.1",
    "svelte-check": "^4.0.0",
    "svelte-preprocess": "^6.0.3",
    "tailwindcss": "4.1.7",
    "terser": "^5.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.0.0"
  }
}
