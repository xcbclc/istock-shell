{
  "name": "istock-shell",
  "private": true,
  "title": "iStock Shell",
  "version": "0.1.7",
  "type": "module",
  "engines": {
    "node": ">=16",
    "pnpm": ">=7"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:docker": "pnpm run build & docker build -f ./Dockerfile -t istock-shell .",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint -c .eslintrc.cjs --ignore-path .eslintignore",
    "lint:fix": "eslint -c .eslintrc.cjs --ignore-path .eslintignore --fix",
    "format": "prettier --write ./**/*.{ts,tsx,js,mjs,cjs,svelte,css,scss,json,md}",
    "prepare": "husky install",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:build:docker": "pnpm run docs:build & docker build -f ./docs/Dockerfile -t istock-shell-doc .",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@antv/g2": "^5.2.12",
    "@commitlint/cli": "^18.6.1",
    "@commitlint/config-conventional": "^18.6.3",
    "@istock/cli": "workspace:^",
    "@rollup/plugin-typescript": "^11.1.6",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/vite": "4.0.16",
    "@tsconfig/svelte": "^5.0.4",
    "@types/qs": "^6.9.18",
    "@types/vue": "^2.0.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "daisyui": "5.0.9",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-standard-with-typescript": "^40.0.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-prettier": "^5.2.5",
    "eslint-plugin-promise": "^6.6.0",
    "eslint-plugin-svelte": "^2.46.1",
    "eslint-plugin-vue": "^9.33.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.5.0",
    "prettier": "^3.5.3",
    "prettier-plugin-svelte": "^3.3.3",
    "prettier-plugin-vue": "^1.1.6",
    "sass": "^1.86.0",
    "shiki": "^2.5.0",
    "svelte": "^5.25.3",
    "svelte-check": "^4.1.5",
    "svelte-preprocess": "^6.0.3",
    "tailwind-variants": "^1.0.0",
    "tailwindcss": "4.0.17",
    "tsc-alias": "^1.8.11",
    "tslib": "^2.8.1",
    "typedoc": "^0.28.1",
    "typedoc-plugin-markdown": "^3.17.1",
    "typescript": "^5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-eslint": "^1.8.1",
    "vite-plugin-pwa": "^0.21.2",
    "vitepress": "2.0.0-alpha.4",
    "vue": "^3.5.13",
    "vue-eslint-parser": "^9.4.3"
  },
  "dependencies": {
    "@istock/command-parser": "workspace:^",
    "@istock/editor": "workspace:^",
    "@istock/iswork": "workspace:^",
    "@istock/shell-ui": "workspace:^",
    "@istock/util": "workspace:^",
    "dayjs": "^1.11.13"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts}": [
      "pnpm run lint",
      "pnpm run format"
    ],
    "*.{html,css,scss,svelte,md}": [
      "pnpm run format"
    ]
  }
}
