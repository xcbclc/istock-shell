{
  "name": "istock-shell",
  "private": true,
  "title": "iStock Shell",
  "version": "0.1.7",
  "type": "module",
  "engines": {
    "node": ">=16",
    "pnpm": ">=7"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:docker": "pnpm run build & docker build -f ./Dockerfile -t istock-shell .",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint -c eslint.config.js",
    "lint:fix": "eslint -c eslint.config.js --fix",
    "format": "prettier --write ./**/*.{ts,tsx,js,mjs,cjs,svelte,css,json,md}",
    "prepare": "husky install",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:build:docker": "pnpm run docs:build & docker build -f ./docs/Dockerfile -t istock-shell-doc .",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@antv/g2": "^5.3.3",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@istock-shell/cli": "workspace:^",
    "@rollup/plugin-typescript": "^12.1.2",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/vite": "4.1.7",
    "@tsconfig/svelte": "^5.0.4",
    "@types/qs": "^6.14.0",
    "@types/vue": "^2.0.0",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "@vite-pwa/assets-generator": "^1.0.0",
    "daisyui": "5.0.35",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-config-standard-with-typescript": "^43.0.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-n": "^17.18.0",
    "eslint-plugin-prettier": "^5.4.0",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-svelte": "^3.9.0",
    "eslint-plugin-vue": "^10.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.5.3",
    "prettier-plugin-svelte": "^3.4.0",
    "prettier-plugin-vue": "^1.1.6",
    "sharp": "^0.34.2",
    "sharp-ico": "^0.1.5",
    "shiki": "^3.4.2",
    "svelte": "^5.33.0",
    "svelte-check": "^4.2.1",
    "svelte-preprocess": "^6.0.3",
    "tailwind-variants": "^1.0.0",
    "tailwindcss": "4.1.7",
    "tsc-alias": "^1.8.16",
    "tslib": "^2.8.1",
    "typedoc": "^0.28.4",
    "typedoc-plugin-markdown": "^4.6.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-eslint": "^1.8.1",
    "vite-plugin-pwa": "^1.0.0",
    "vitepress": "1.6.3",
    "vue": "^3.5.14",
    "vue-eslint-parser": "^10.1.3"
  },
  "dependencies": {
    "@istock-shell/command-parser": "workspace:^",
    "@istock-shell/editor": "workspace:^",
    "@istock-shell/iswork": "workspace:^",
    "@istock-shell/ui": "workspace:^",
    "@istock-shell/util": "workspace:^",
    "dayjs": "^1.11.13"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,svelte,vue}": [
      "pnpm run lint:fix",
      "pnpm run format"
    ],
    "*.{html,css,scss,md}": [
      "pnpm run format"
    ]
  }
}
